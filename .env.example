# 监听端口
PORT=8765

# SQLite 数据库路径
DB_PATH=/data/db/reminder.db

# JWT 签名密钥（留空则自动生成）
JWT_SECRET=

# 初始管理员账号（仅首次建库时生效）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 通道敏感字段加密密钥（base64 编码的 32 字节）；未配置时使用内置 fallback
ENCRYPTION_KEY=

# 日志自动清理保留天数；0 表示不自动清理
LOG_AUTO_PURGE_DAYS=0

# 日志输出格式：text（默认，[INFO] 时间 | request_id | 消息 k=v 一行制式）或 json（适合日志采集）
LOG_FORMAT=text

# 日志级别：debug | info（默认）| warn | error
# 默认级别下不记录成功请求的访问日志；debug 会额外打印每条 SQL、访问日志与通道发送细节
LOG_LEVEL=info
