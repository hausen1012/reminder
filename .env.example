# 监听端口
PORT=8765

# SQLite 数据库路径
DB_PATH=/data/db/reminder.db

# JWT 签名密钥（留空则自动生成）
JWT_SECRET=

# 初始管理员账号
USERNAME=admin
PASSWORD=admin123

# 通道敏感字段加密密钥（base64 编码的 32 字节）；未配置时使用内置 fallback
ENCRYPTION_KEY=

# 对外可访问的根 URL，用于拼接确认链接
BASE_URL=http://localhost:8765

# 站点时区的初始默认值；首次启动后可在面板「设置」页修改并即时生效
TIMEZONE=Asia/Shanghai

# 调度补漏扫描间隔（秒）
SWEEP_INTERVAL_SEC=60

# 漏触发容忍上限（分钟），早于此的提醒标记为 expired 不再发送
MISS_TOLERANCE_MINUTES=60

# 日志自动清理保留天数；0 表示不自动清理
LOG_AUTO_PURGE_DAYS=0

# 日志目录；留空时使用默认值 /var/log/reminder
LOG_FILE=

# 日志输出格式：text（默认，适合手动排查）或 json（适合日志采集）
LOG_FORMAT=text

# 日志级别：debug | info（默认）| warn | error
# debug 会额外打印每条 SQL 与通道发送细节，排查问题时临时调高即可
LOG_LEVEL=info

# 单个请求体大小上限（MB），超出返回 413 payload_too_large
MAX_BODY_MB=1

# 可信反向代理的 IP / CIDR，逗号分隔，如 127.0.0.1,172.18.0.0/16
# 留空表示不信任任何代理头（客户端 IP 取 TCP 对端地址）；不要填 0.0.0.0/0
TRUSTED_PROXIES=

# 连续登录失败多少次后临时锁定；0 表示关闭登录限流
LOGIN_MAX_ATTEMPTS=5

# 登录锁定时长（分钟）
LOGIN_LOCKOUT_MINUTES=15
