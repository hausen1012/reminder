# 监听端口
PORT=8765

# SQLite 数据库路径
DB_PATH=/data/db/reminder.db

# JWT 签名密钥（留空则自动生成）
JWT_SECRET=

# 初始管理员账号
USERNAME=admin
PASSWORD=admin123

# 通道敏感字段加密密钥（base64 编码的 32 字节）；未配置时使用内置 fallback
ENCRYPTION_KEY=

# 对外可访问的根 URL，用于拼接确认链接
BASE_URL=http://localhost:8765

# 时区
TIMEZONE=Asia/Shanghai

# 调度补漏扫描间隔（秒）
SWEEP_INTERVAL_SEC=60

# 漏触发容忍上限（分钟），早于此的提醒标记为 expired 不再发送
MISS_TOLERANCE_MINUTES=60

# 日志自动清理保留天数；0 表示不自动清理
LOG_AUTO_PURGE_DAYS=0

# 日志文件目录路径；为空默认使用项目根目录下的 logs/
LOG_FILE=
